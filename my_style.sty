% Double Coulmns 
\newcommand{\cols}[2]{
    \begin{columns}
        \begin{column}{0.45\textwidth}
        #1 % content in 1st col
        \end{column}
        
        \begin{column}{0.45\textwidth}
        #2 % content in 2nd col
        \end{column}
    \end{columns}
}
% usage: \cols{ bunch of text here}{\includegraphics[fig.png]}


%% SECTION FRAME %%
\newcommand{\sectionframe}[1]{
\addtocounter{framenumber}{-1}
\begin{frame}
    \begin{block}{}
    \begin{center}
    \huge 
    #1
    \end{center}
    \end{block}
\end{frame}
}

% usage: \sectionframe{name of section}, makes a slide 

\newcommand{\red}[1]{\textcolor{red}{#1}}

