%% EXAMPLE %% 
% already defined just do \example{}

%% DEFINE %%
\newcommand{\define}[2]{
\setbeamercolor{block title}{use=structure,fg=dark_fg,bg=def_color}
\setbeamercolor{block body}{use=structure,fg=black,bg=def_color!25}
\begin{block}{Definition: #1} 
#2 % text 
\end{block}
}

%% KEY IDEA %%
\newcommand{\keyidea}[1]{
\setbeamercolor{block title}{use=structure,fg=light_fg,bg=key_color}
\setbeamercolor{block body}{use=structure,fg=black,bg=key_color!25}
\begin{block}{Key Idea} 
#1 % text 
\end{block}
}

%% QUESTION %%
\newcommand{\question}[1]{
\setbeamercolor{block title}{use=structure,fg=light_fg,bg=question_color}
\setbeamercolor{block body}{use=structure,fg=black,bg=question_color!25}
\begin{block}{Question} 
#1 % text 
\end{block}
}

%% METHOD %%
\newcommand{\method}[4]{
\setbeamercolor{block title}{use=structure,fg=dark_fg,bg=method_color}
\setbeamercolor{block body}{use=structure,fg=black,bg=method_color!25}
\begin{block}{Method: #1}
\color{green} 
\begin{itemize}
    \item \textbf{Given}: #2
    \item \textbf{Output}: #3
    \item \textbf{Idea}: #4
\end{itemize}
\end{block}
}

